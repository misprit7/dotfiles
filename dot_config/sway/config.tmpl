### Shared config ###
include ~/.config/wm/config

### Environment ###
# GPU + scaling env vars are in ~/.config/environment.d/sway-env.conf
# (sourced by systemd for graphical sessions via SDDM)

# Export to systemd/dbus for child processes (portals, etc.)
exec export XDG_CURRENT_DESKTOP=sway && dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

{{ if eq .chezmoi.hostname "oko" -}}
### Monitors ###
# DP-1 center, HDMI-A-1 right, HDMI-A-2 left (TV)
output DP-1 pos 0 0 scale 1.5
output HDMI-A-1 pos 2560 0 scale 1.5
output HDMI-A-2 pos -2560 0 scale 1.5

### Workspace → Output Assignments ###
workspace L1 output DP-1
workspace L2 output DP-1
workspace L3 output DP-1
workspace L4 output DP-1
workspace L5 output DP-1
workspace L6 output DP-1
workspace L7 output DP-1
workspace L8 output DP-1
workspace L9 output DP-1
workspace L10 output DP-1
workspace R1 output HDMI-A-1
workspace R2 output HDMI-A-1
workspace R3 output HDMI-A-1
workspace R4 output HDMI-A-1
workspace R5 output HDMI-A-1
workspace R6 output HDMI-A-1
workspace R7 output HDMI-A-1
workspace R8 output HDMI-A-1
workspace R9 output HDMI-A-1
workspace R10 output HDMI-A-1
workspace TV1 output HDMI-A-2
{{- else -}}
### Monitors ###
# Single built-in panel. Workspaces are not pinned to an output — with one
# output the L* prefix from ~/.config/sway/bin/* lands here anyway.
output eDP-1 scale 1.5

### Gaps ###
# No gaps on the laptop — overrides the shared defaults in ~/.config/wm/config.
gaps inner 0
gaps outer 0
{{- end }}

### Wallpaper ###
output * bg /home/xander/Documents/wallpaper/city-skyline.jpg fill

### XWayland ###
xwayland enable

### Input ###
input type:keyboard {
    xkb_layout us
    repeat_delay 200
    repeat_rate 30
}

input type:pointer {
    pointer_accel 0.2
}

input type:touchpad {
    # Tap to click: 1 finger = left, 2 fingers = right, 3 fingers = middle.
    tap enabled
    tap_button_map lrm

    # Tap-and-drag: tap, then immediately touch again to drag. drag_lock off
    # means lifting the finger ends the drag rather than latching it.
    drag enabled
    drag_lock disabled

    # This is a clickpad (no separate physical buttons), so divide clicks by
    # finger count instead of by pad region — 2-finger click = right button,
    # 3-finger click = middle. Region-based clicking has no right zone here.
    click_method clickfinger

    # Two-finger scrolling. Direction matches the desktop (not "natural").
    scroll_method two_finger
    natural_scroll disabled

    # Don't move the pointer from a palm brush while typing.
    dwt enabled

    # Adaptive acceleration gives fine control slowly and distance quickly.
    accel_profile adaptive
    pointer_accel 0.3
}

### Autostart ###
exec waybar &
exec nm-applet &
exec pasystray &
# Bring up the systemd user graphical session. This activates
# graphical-session.target, which xdg-desktop-portal now hard-requires
# (Requisite=graphical-session.target); the portals D-Bus-activate on demand.
exec systemctl --user start sway-session.target

### Sway-specific keybindings ###

# Screenshot (grim + slurp → clipboard + file)
bindsym $mod+$smod+s exec grim -g "$(slurp)" - | tee ~/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png | wl-copy

# Reload sway config
bindsym $mod+$smod+z reload

# Numlock
input type:keyboard xkb_numlock enabled

### Touchpad gestures ###
# macOS-style. These no-op on machines with no touchpad, so they stay in the
# shared section rather than the per-machine branch above.
#
# Note: libinput only reports swipes of 3 fingers or more — a 2-finger swipe is
# scrolling — so macOS's 2-finger back/forward cannot be reproduced. Back and
# forward live on 3 fingers here, and workspace switching moves up to 4.

# Three fingers horizontal — browser/file-manager back and forward.
# Direction matches macOS: content follows the fingers, so swiping right
# (dragging the page rightwards) goes back. sway cannot synthesise keys
# itself, hence wtype.
bindgesture swipe:3:right exec wtype -M alt -k Left -m alt
bindgesture swipe:3:left  exec wtype -M alt -k Right -m alt

# Three fingers up — window overview, the Mission Control equivalent.
# sway has no built-in overview, so this is rofi's window switcher.
bindgesture swipe:3:up exec rofi -show window

# Three fingers down — jump back to the previously focused workspace.
bindgesture swipe:3:down exec swaymsg workspace back_and_forth

# Four fingers horizontal — move between workspaces on the focused output,
# the gesture equivalent of $mod+n / $mod+p (macOS "switch spaces").
bindgesture swipe:4:left  exec ~/.config/sway/bin/cycle-workspace next
bindgesture swipe:4:right exec ~/.config/sway/bin/cycle-workspace prev
