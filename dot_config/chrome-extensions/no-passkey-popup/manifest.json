{
  "manifest_version": 3,
  "name": "No Chrome passkey popup",
  "version": "1.0",
  "description": "Stops Chrome's own \"Use a passkey from another device\" dropdown from opening on login fields, where it covers the password manager's menu. Passkey sign-in buttons keep working.",
  "key": "",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["block-passkey-autofill.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
